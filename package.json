{
  "name": "@fca.gg/kob",
  "version": "1.0.0",
  "description": "HTTP Library for Node.JS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf lib/",
    "dev": "npm run clean && tsc && concurrently -k -n \"Typescript,Node\" -p \"[{name}]\" -c \"blue,green\" \"tsc --watch\" \"nodemon --inspect dist/index.js\"",
    "build": "npm run clean && tsc",
    "prod-build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "content-disposition": "^0.5.4",
    "content-type": "^1.0.5",
    "cookies": "^0.8.0",
    "debug": "^4.3.2",
    "destroy": "^1.0.4",
    "encodeurl": "^1.0.2",
    "fresh": "~0.5.2",
    "on-finished": "^2.3.0",
    "parseurl": "^1.3.2",
    "querystring": "^0.2.1",
    "vary": "^1.1.2"
  },
  "devDependencies": {
    "@types/accepts": "^1.3.5",
    "@types/content-disposition": "^0.5.5",
    "@types/content-type": "^1.1.5",
    "@types/cookies": "^0.7.7",
    "@types/debug": "^4.1.8",
    "@types/destroy": "^1.0.0",
    "@types/encodeurl": "^1.0.0",
    "@types/fresh": "^0.5.0",
    "@types/http-errors": "^2.0.1",
    "@types/node": "^20.3.1",
    "@types/on-finished": "^2.3.1",
    "@types/parseurl": "^1.3.1",
    "@types/vary": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^5.42.1",
    "@typescript-eslint/parser": "^5.42.1",
    "eslint": "^8.43.0"
  },
  "repository": {
