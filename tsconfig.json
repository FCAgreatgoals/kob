{
    "compilerOptions": {
        "module": "commonjs",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "esnext",
        "pretty": true,
        "strict": true,
        "outDir": "./lib",
        "declaration": true,
        "removeComments": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
